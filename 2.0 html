<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no">
  <title>Mech Battlegrounds</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #05070d;
      --bg2: #0b1220;
      --panel: rgba(11, 17, 28, 0.82);
      --panel-strong: rgba(16, 26, 42, 0.95);
      --line: rgba(99, 190, 255, 0.25);
      --c1: #3be8ff;
      --c2: #ff3fa8;
      --good: #5dffb0;
      --bad: #ff5a6e;
      --txt: #eaf6ff;
      --dim: #aec6dc;
      --shadow: rgba(0, 0, 0, 0.35);
      --danger: #ff6f6f;
      --safe: #7ef7c3;
      --ease: cubic-bezier(.2,.8,.2,1);
    }

    * { box-sizing: border-box; }
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      background: var(--bg);
      color: var(--txt);
      font-family: "Rajdhani", system-ui, -apple-system, sans-serif;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      touch-action: none;
    }

    body {
      background:
        radial-gradient(circle at 20% 20%, rgba(23, 50, 95, 0.92), transparent 35%),
        radial-gradient(circle at 80% 25%, rgba(255, 63, 168, 0.2), transparent 30%),
        linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%);
    }

    button {
      font: inherit;
      color: inherit;
      background: none;
      border: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    .hidden { display: none !important; }

    #app {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    #bgfx {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background: radial-gradient(120% 90% at 70% 40%, #112544 0%, #070b16 55%, #03050a 100%);
    }

    .grid {
      position: absolute;
      left: -30%;
      right: -30%;
      bottom: -18%;
      height: 74%;
      background-image:
        linear-gradient(rgba(59, 232, 255, 0.16) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 232, 255, 0.16) 1px, transparent 1px);
      background-size: 48px 48px;
      transform: perspective(480px) rotateX(70deg);
      opacity: 0.8;
      animation: gridMove 12s linear infinite;
    }

    @keyframes gridMove {
      from { background-position: 0 0; }
      to { background-position: 0 48px; }
    }

    .glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.4;
      animation: drift 14s ease-in-out infinite alternate;
    }

    .g1 { width: 48vw; height: 48vw; left: 45%; top: -10%; background: #1b6cff; }
    .g2 { width: 40vw; height: 40vw; left: -10%; top: 42%; background: #ff2e93; opacity: 0.22; animation-duration: 17s; }

    @keyframes drift {
      to { transform: translate(-8vw, 10vh) scale(1.15); }
    }

    .scanline {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.02) 0,
        rgba(255,255,255,0.02) 1px,
        transparent 1px,
        transparent 3px
      );
      mix-blend-mode: overlay;
    }

    .vignette {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, transparent 52%, rgba(0,0,0,0.6) 100%);
    }

    .hud {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 4;
    }

    .statusbar {
      position: absolute;
      top: max(12px, env(safe-area-inset-top));
      left: 14px;
      right: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      z-index: 5;
      pointer-events: none;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 38px;
      padding: 0 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(11, 18, 30, 0.72);
      backdrop-filter: blur(8px);
      font-family: "Orbitron", sans-serif;
      font-weight: 700;
      letter-spacing: 0.12em;
      font-size: 11px;
      color: var(--txt);
    }

    .chip .dot {
      width: 10px;
      height: 10px;
      border-radius: 3px;
      background: var(--c1);
      box-shadow: 0 0 12px rgba(59, 232, 255, 0.8);
      transform: rotate(45deg);
    }

    .chip.warning .dot {
      background: #ffb14a;
      box-shadow: 0 0 12px rgba(255,177,74,0.7);
    }

    .title {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      z-index: 6;
      pointer-events: none;
    }

    .title h1 {
      margin: 0;
      font-family: "Orbitron", sans-serif;
      font-size: clamp(22px, 8vw, 44px);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      text-shadow: 0 0 24px rgba(59, 232, 255, 0.7);
    }

    .title p {
      margin-top: 8px;
      font-size: 11px;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: var(--dim);
    }

    .menu {
      position: absolute;
      inset: 0;
      z-index: 10;
      padding: max(86px, calc(env(safe-area-inset-top) + 18px)) 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 0 4px;
    }

    .logo {
      font-family: "Orbitron", sans-serif;
      font-size: clamp(16px, 4vw, 26px);
      letter-spacing: 0.18em;
      line-height: 1.05;
      text-transform: uppercase;
      font-weight: 900;
      text-shadow: 0 0 18px rgba(59, 232, 255, 0.55);
    }

    .logo span { color: var(--c1); }
    .logo small {
      display: block;
      margin-top: 6px;
      font-family: "Rajdhani", sans-serif;
      font-size: 10px;
      letter-spacing: 0.32em;
      color: var(--dim);
      text-transform: uppercase;
    }

    .nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      width: 100%;
      margin-top: 4px;
    }

    .nav button {
      position: relative;
      min-height: 68px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(13, 20, 30, 0.7);
      padding: 10px 8px;
      text-align: left;
      font-family: "Orbitron", sans-serif;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--dim);
      transition: transform .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease;
    }

    .nav button.active {
      color: var(--txt);
      border-color: rgba(59, 232, 255, 0.7);
      background: linear-gradient(180deg, rgba(59, 232, 255, 0.13), rgba(12, 17, 28, 0.66));
      box-shadow: inset 0 0 0 1px rgba(59, 232, 255, 0.2), 0 0 18px rgba(59, 232, 255, 0.12);
    }

    .nav button:active { transform: scale(0.98); }
    .nav small {
      display: block;
      margin-top: 4px;
      font-family: "Rajdhani", sans-serif;
      letter-spacing: 0.12em;
      font-size: 10px;
      color: var(--dim);
      opacity: 0.9;
    }

    .panels {
      position: relative;
      flex: 1;
      min-height: 0;
      width: 100%;
      overflow: hidden;
    }

    .panel {
      position: absolute;
      inset: 0;
      overflow-y: auto;
      padding-bottom: 18px;
      display: none;
      scrollbar-width: thin;
      scrollbar-color: rgba(59, 232, 255, 0.35) transparent;
    }

    .panel.active { display: block; }

    .panel-inner {
      display: grid;
      gap: 12px;
      padding: 6px 2px 12px;
    }

    .card {
      position: relative;
      padding: 14px 14px 12px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--panel);
      backdrop-filter: blur(10px);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02);
    }

    .card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 16px;
      height: 16px;
      border-left: 2px solid var(--c1);
      border-top: 2px solid var(--c1);
      border-top-left-radius: 10px;
    }

    .card h3 {
      margin: 0 0 8px;
      font-family: "Orbitron", sans-serif;
      letter-spacing: 0.14em;
      font-size: 12px;
      text-transform: uppercase;
      color: var(--txt);
    }

    .card p {
      margin: 0;
      color: var(--dim);
      line-height: 1.5;
      font-size: 14px;
    }

    .cta {
      width: 100%;
      min-height: 56px;
      border: 1px solid rgba(59, 232, 255, 0.7);
      border-radius: 12px;
      background: linear-gradient(90deg, #3be8ff, #8bf7ff 50%, #ff3fa8 100%);
      background-size: 200% 100%;
      color: #041219;
      font-family: "Orbitron", sans-serif;
      font-weight: 900;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      animation: pulseGlow 2.4s ease-in-out infinite;
    }

    @keyframes pulseGlow {
      50% { box-shadow: 0 0 26px rgba(59, 232, 255, 0.65); }
    }

    .stat-row {
      display: grid;
      grid-template-columns: 76px 1fr 48px;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
      color: var(--dim);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .bar {
      position: relative;
      height: 9px;
      border-radius: 999px;
      background: rgba(255,255,255,0.08);
      overflow: hidden;
    }

    .bar i {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--c1), #8bf7ff);
      box-shadow: 0 0 12px rgba(59, 232, 255, 0.7);
    }

    .bar.half i { width: 62%; }
    .bar.three i { width: 72%; }
    .bar.sun i { width: 89%; background: linear-gradient(90deg, #ffb34a, #ff5a6e); }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 10px;
    }

    .tag {
      padding: 5px 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--txt);
      background: rgba(255,255,255,0.02);
    }

    .mini-map {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
    }

    .map-art {
      width: 92px;
      height: 66px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background:
        linear-gradient(to bottom, #8fc3f0 0%, #dfeef8 42%, #4b8b35 42%, #2f6125 100%);
      position: relative;
      overflow: hidden;
    }

    .map-art::before {
      content: "";
      position: absolute;
      inset: auto -10% 18% -10%;
      height: 42%;
      background: rgba(44, 81, 54, 0.8);
      clip-path: polygon(0 100%, 14% 30%, 38% 72%, 56% 12%, 78% 65%, 100% 100%);
    }

    .map-art::after {
      content: "";
      position: absolute;
      right: 16px;
      bottom: 12px;
      width: 22px;
      height: 18px;
      background: rgba(241, 236, 214, 0.8);
      box-shadow: -16px 3px 0 -3px rgba(158, 149, 118, 0.8), 12px 2px 0 -3px rgba(157, 121, 80, 0.8);
    }

    .bottom-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    .bottom-actions button,
    .pickup-grid button,
    .shop-item button {
      min-height: 45px;
      border: 1px solid var(--line);
      background: rgba(14, 22, 34, 0.72);
      border-radius: 10px;
      color: var(--txt);
      font-family: "Orbitron", sans-serif;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 10px;
      padding: 0 12px;
    }

    .pickup-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 12px;
    }

    .shop-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: rgba(8, 14, 22, 0.75);
    }

    .shop-item strong {
      display: block;
      font-family: "Orbitron", sans-serif;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .shop-item span {
      font-size: 12px;
      color: var(--dim);
    }

    .shop-item button {
      min-width: 86px;
    }

    .touch-pad {
      position: absolute;
      left: 16px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      width: 112px;
      height: 112px;
      border-radius: 50%;
      border: 1px solid rgba(59, 232, 255, 0.38);
      background: rgba(11, 20, 30, 0.46);
      backdrop-filter: blur(6px);
      box-shadow: inset 0 0 20px rgba(59, 232, 255, 0.08);
      pointer-events: auto;
      z-index: 16;
    }

    .touch-stick {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 42px;
      height: 42px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: linear-gradient(180deg, rgba(59, 232, 255, 0.6), rgba(59, 232, 255, 0.1));
      border: 1px solid rgba(59, 232, 255, 0.8);
      box-shadow: 0 0 15px rgba(59, 232, 255, 0.18);
      transition: transform .08s linear;
    }

    .touch-actions {
      position: absolute;
      right: 16px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      display: flex;
      gap: 10px;
      z-index: 16;
      pointer-events: auto;
    }

    .touch-btn {
      display: grid;
      place-items: center;
      width: 58px;
      height: 58px;
      border-radius: 18px;
      background: rgba(17, 25, 36, 0.72);
      border: 1px solid rgba(255, 63, 168, 0.33);
      color: var(--txt);
      font-family: "Orbitron", sans-serif;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      box-shadow: 0 0 18px rgba(255, 63, 168, 0.14);
    }

    .touch-btn.primary {
      border-color: rgba(59, 232, 255, 0.5);
      color: var(--c1);
    }

    .touch-btn:active {
      transform: scale(0.96);
    }

    .game-wrap {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }

    .game-wrap.visible {
      pointer-events: auto;
    }

    #gameCanvas {
      opacity: 0.9;
    }

    .smallcaps {
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dim);
    }

    @media (min-width: 760px) {
      .menu {
        padding-left: 22px;
        padding-right: 22px;
      }
      .panel-inner {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .card.wide { grid-column: 1 / -1; }
    }

    @media (max-width: 520px) {
      .logo small {
        letter-spacing: 0.2em;
      }
      .nav {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .touch-pad {
        width: 96px;
        height: 96px;
      }
      .touch-btn {
        width: 52px;
        height: 52px;
      }
      .title {
        top: 42%;
      }
      .statusbar {
        left: 10px;
        right: 10px;
      }
      .chip {
        padding: 0 10px;
        min-height: 32px;
        font-size: 10px;
        letter-spacing: 0.1em;
      }
    }
  </style>
</head>
<body>
  <div id="app">
    <div id="bgfx">
      <div class="grid"></div>
      <div class="glow g1"></div>
      <div class="glow g2"></div>
      <div class="scanline"></div>
      <div class="vignette"></div>
    </div>

    <div class="hud">
      <div class="statusbar">
        <div class="chip"><span class="dot"></span> <span>0</span></div>
        <div class="chip warning"><span class="dot"></span> <span>TK 0</span></div>
      </div>
      <div class="title">
        <h1>Mech<br>Battlegrounds</h1>
        <p>Prototype // Mobile build</p>
      </div>
    </div>

    <div class="menu">
      <div class="topbar">
        <div class="logo">Mech<span> / </span>Battlegrounds<small>Prototype · Build 0.2</small></div>
      </div>

      <div class="nav" id="nav">
        <button class="active" data-screen="play">Play<small>Deploy</small></button>
        <button data-screen="mechs">Mechs<small>Builds</small></button>
        <button data-screen="shop">Shop<small>Parts</small></button>
        <button data-screen="quests">Quests<small>Rewards</small></button>
      </div>

      <div class="panels">
        <section class="panel active" data-panel="play">
          <div class="panel-inner">
            <div class="card wide">
              <h3>Battlefield</h3>
              <p>Open desert to city edge. Small combat sandbox built for mobile, with large controls and simplified HUD.</p>
              <div class="mini-map">
                <div class="map-art"></div>
                <div>
                  <div class="smallcaps">Zone</div>
                  <p style="margin-top:8px;">North Ridge / Old Town</p>
                </div>
              </div>
            </div>

            <div class="card">
              <h3>Active build</h3>
              <p>AVA MK-I</p>
              <div class="tags">
                <span class="tag">R: Gatling</span>
                <span class="tag">L: Blade</span>
                <span class="tag">Hull 100</span>
              </div>
            </div>

            <div class="card">
              <h3>Loadout</h3>
              <div class="stat-row">
                <span>Hull</span>
                <div class="bar half"><i></i></div>
                <b>100</b>
              </div>
              <div class="stat-row">
                <span>Energy</span>
                <div class="bar three"><i></i></div>
                <b>72</b>
              </div>
              <div class="stat-row">
                <span>Heat</span>
                <div class="bar sun"><i></i></div>
                <b>86</b>
              </div>
            </div>

            <div class="card wide">
              <button class="cta" id="deployBtn">Deploy</button>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="mechs">
          <div class="panel-inner">
            <div class="card wide">
              <h3>Workshop</h3>
              <p>Large tap targets and vertical stacking for smaller screens.</p>
              <div class="tags">
                <span class="tag">Gatling</span>
                <span class="tag">Pulse</span>
                <span class="tag">Boost pack</span>
              </div>
            </div>

            <div class="card">
              <h3>Builds</h3>
              <div class="bottom-actions">
                <button>AVA MK-I</button>
                <button>+ New</button>
              </div>
            </div>

            <div class="card">
              <h3>Equip</h3>
              <div class="pickup-grid">
                <button>Weapon</button>
                <button>Arms</button>
                <button>Legs</button>
                <button>Armor</button>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="shop">
          <div class="panel-inner">
            <div class="card wide">
              <h3>Parts shop</h3>
              <p>Spend credits or collaboration tokens to unlock the next set of parts.</p>
            </div>

            <div class="card">
              <div class="shop-item">
                <div>
                  <strong>Pulse Rifle</strong>
                  <span>450 cr</span>
                </div>
                <button>Buy</button>
              </div>
            </div>

            <div class="card">
              <div class="shop-item">
                <div>
                  <strong>Heavy Actuators</strong>
                  <span>700 cr</span>
                </div>
                <button>Buy</button>
              </div>
            </div>

            <div class="card">
              <div class="shop-item">
                <div>
                  <strong>Speaker Module</strong>
                  <span>4 tk</span>
                </div>
                <button>Buy</button>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="quests">
          <div class="panel-inner">
            <div class="card wide">
              <h3>Objectives</h3>
              <p>Progress is tracked inside matches. Quests update as you destroy barrels, land melee hits, and complete field operations.</p>
            </div>

            <div class="card">
              <h3>Hold the Trigger</h3>
              <p>Fire 300 primary rounds</p>
              <div class="bar half" style="margin-top:10px;"><i></i></div>
            </div>

            <div class="card">
              <h3>Blade Practice</h3>
              <p>Land 40 melee hits</p>
              <div class="bar three" style="margin-top:10px;"><i></i></div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="game-wrap" id="gameWrap">
      <canvas id="gameCanvas" width="800" height="500"></canvas>
    </div>

    <div class="touch-pad" id="movePad" aria-label="Movement pad">
      <div class="touch-stick" id="moveStick"></div>
    </div>

    <div class="touch-actions">
      <button class="touch-btn primary" id="fireBtn" aria-label="Fire">Fire</button>
      <button class="touch-btn" id="boostBtn" aria-label="Boost">Boost</button>
    </div>
  </div>

  <script>
    const navButtons = document.querySelectorAll('.nav button');
    const panels = document.querySelectorAll('.panel');
    const gameWrap = document.getElementById('gameWrap');
    const deployBtn = document.getElementById('deployBtn');

    navButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        navButtons.forEach(b => b.classList.toggle('active', b === btn));
        const screen = btn.dataset.screen;
        panels.forEach(p => p.classList.toggle('active', p.dataset.panel === screen));
      });
    });

    deployBtn.addEventListener('click', () => {
      document.querySelector('.title').style.opacity = '0';
      gameWrap.classList.add('visible');
      document.querySelector('.menu').classList.add('hidden');
    });

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let w = 0, h = 0;
    const input = { x: 0, y: 0, firing: false, boosting: false };
    let player = { x: 160, y: 330, vx: 0, vy: 0, dir: 1, shotCooldown: 0, energy: 100 };
    const bullets = [];

    function resizeCanvas() {
      const parent = canvas.parentElement;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.clientWidth;
      h = parent.clientHeight;
      canvas.width = Math.max(320, Math.floor(w * dpr));
      canvas.height = Math.max(240, Math.floor(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function pointerVector(clientX, clientY, pad) {
      const rect = pad.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      let dx = (clientX - cx) / (rect.width / 2);
      let dy = (clientY - cy) / (rect.height / 2);
      dx = Math.max(-1, Math.min(1, dx));
      dy = Math.max(-1, Math.min(1, dy));
      return { x: dx, y: dy };;
    }

    function bindPad(elem, onMove, onEnd) {
      let active = false;
      const stick = elem.querySelector('.touch-stick') || elem;
      const setStick = (dx, dy) => {
        const scale = 28;
        const sx = dx * scale;
        const sy = dy * scale;
        stick.style.transform = `translate(${sx - 21}px, ${sy - 21}px)`;
      };

      elem.addEventListener('pointerdown', (e) => {
        active = true;
        elem.setPointerCapture(e.pointerId);
        const v = pointerVector(e.clientX, e.clientY, elem);
        setStick(v.x, v.y);
        onMove(v.x, v.y);
      });

      elem.addEventListener('pointermove', (e) => {
        if (!active) return;
        const v = pointerVector(e.clientX, e.clientY, elem);
        setStick(v.x, v.y);
        onMove(v.x, v.y);
      });

      const release = (e) => {
        if (!active) return;
        active = false;
        setStick(0, 0);
        onEnd();
      };

      elem.addEventListener('pointerup', release);
      elem.addEventListener('pointercancel', release);
    }

    const movePad = document.getElementById('movePad');
    const fireBtn = document.getElementById('fireBtn');
    const boostBtn = document.getElementById('boostBtn');

    bindPad(movePad, (x, y) => {
      input.x = x;
      input.y = y;
    }, () => {
      input.x = 0;
      input.y = 0;
    });

    fireBtn.addEventListener('pointerdown', () => {
      input.firing = true;
      fireBtn.style.transform = 'scale(0.96)';
    });
    const releaseFire = () => {
      input.firing = false;
      fireBtn.style.transform = '';
    };
    fireBtn.addEventListener('pointerup', releaseFire);
    fireBtn.addEventListener('pointercancel', releaseFire);

    boostBtn.addEventListener('pointerdown', () => {
      input.boosting = true;
      boostBtn.style.transform = 'scale(0.96)';
    });
    const releaseBoost = () => {
      input.boosting = false;
      boostBtn.style.transform = '';
    };
    boostBtn.addEventListener('pointerup', releaseBoost);
    boostBtn.addEventListener('pointercancel', releaseBoost);

    document.addEventListener('keydown', (e) => {
      if (e.code === 'KeyA' || e.code === 'ArrowLeft') input.x = -1;
      if (e.code === 'KeyD' || e.code === 'ArrowRight') input.x = 1;
      if (e.code === 'KeyW' || e.code === 'ArrowUp') input.y = -1;
      if (e.code === 'KeyS' || e.code === 'ArrowDown') input.y = 1;
      if (e.code === 'Space') input.boosting = true;
      if (e.code === 'KeyJ') input.firing = true;
    });

    document.addEventListener('keyup', (e) => {
      if (['KeyA','KeyD','ArrowLeft','ArrowRight'].includes(e.code)) input.x = 0;
      if (['KeyW','KeyS','ArrowUp','ArrowDown'].includes(e.code)) input.y = 0;
      if (e.code === 'Space') input.boosting = false;
      if (e.code === 'KeyJ') input.firing = false;
    });

    function step(delta) {
      const moveSpeed = input.boosting ? 4.5 : 3.2;
      player.vx = input.x * moveSpeed;
      player.vy = input.y * moveSpeed;
      player.x += player.vx * delta * 60;
      player.y += player.vy * delta * 60;
      player.x = Math.max(32, Math.min(w - 32, player.x));
      player.y = Math.max(54, Math.min(h - 32, player.y));

      if (input.firing && player.shotCooldown <= 0) {
        bullets.push({ x: player.x + 30, y: player.y, vx: 8, vy: 0, life: 1.2 });
        player.shotCooldown = 0.12;
      }
      player.shotCooldown = Math.max(0, player.shotCooldown - delta);

      for (let i = bullets.length - 1; i >= 0; i--) {
        const b = bullets[i];
        b.x += b.vx * 60 * delta;
        b.life -= delta;
        if (b.x > w + 20 || b.life <= 0) bullets.splice(i,1);
      }
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#0a1018';
      ctx.fillRect(0, 0, w, h);

      const sky = ctx.createLinearGradient(0, 0, 0, h);
      sky.addColorStop(0, '#0d1930');
      sky.addColorStop(1, '#04070d');
      ctx.fillStyle = sky;
      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = 'rgba(59, 232, 255, 0.12)';
      ctx.lineWidth = 1;
      for (let y = 0; y < h; y += 26) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      ctx.fillStyle = '#1b3321';
      ctx.fillRect(0, h - 70, w, 70);
      ctx.fillStyle = '#294d30';
      for (let i = 0; i < 22; i++) {
        const px = (i * 93 + (player.x * 0.2)) % (w + 80);
        ctx.beginPath();
        ctx.moveTo(px, h - 70);
        ctx.lineTo(px + 28, h - 90);
        ctx.lineTo(px + 52, h - 70);
        ctx.closePath();
        ctx.fill();
      }

      for (const b of bullets) {
        ctx.fillStyle = '#ffdd7d';
        ctx.fillRect(b.x - 10, b.y - 2, 18, 4);
      }

      const mechX = player.x;
      const mechY = player.y;
      ctx.save();
      ctx.translate(mechX, mechY);
      if (input.boosting) {
        ctx.fillStyle = 'rgba(59, 232, 255, 0.8)';
        ctx.beginPath();
        ctx.moveTo(-12, 24);
        ctx.lineTo(-22, 44);
        ctx.lineTo(-8, 38);
        ctx.lineTo(0, 52);
        ctx.lineTo(8, 38);
        ctx.lineTo(22, 44);
        ctx.lineTo(12, 24);
        ctx.closePath();
        ctx.fill();
      }

      ctx.fillStyle = '#a5b7cc';
      ctx.fillRect(-18, 0, 36, 24);
      ctx.fillStyle = '#7087a6';
      ctx.fillRect(-24, -8, 48, 12);
      ctx.fillStyle = '#3be8ff';
      ctx.fillRect(-10, -18, 20, 14);
      ctx.fillStyle = '#111828';
      ctx.fillRect(-6, -14, 12, 8);

      ctx.fillStyle = '#d9eefb';
      ctx.fillRect(-26, 18, 12, 20);
      ctx.fillRect(14, 18, 12, 20);
      ctx.fillStyle = '#6b7e96';
      ctx.fillRect(-30, 36, 16, 10);
      ctx.fillRect(14, 36, 16, 10);

      ctx.fillStyle = '#ff3fa8';
      ctx.fillRect(26, -2, 18, 6);
      ctx.fillStyle = '#3be8ff';
      ctx.fillRect(-32, -2, 18, 6);
      ctx.restore();
    }

    let lastTime = 0;
    function animate(ts) {
      const dt = Math.min(0.032, (ts - lastTime) / 1000 || 0.016);
      lastTime = ts;
      step(dt);
      draw();
      requestAnimationFrame(animate);
    }

    resizeCanvas();
    requestAnimationFrame(animate);
    window.addEventListener('resize', resizeCanvas);
  </script>
</body>
</html>
